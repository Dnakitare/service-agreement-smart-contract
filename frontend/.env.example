# Address of the ServiceAgreement proxy on whatever network your wallet is connected to.
# For local Hardhat, this is whatever upgrades.deployProxy printed when running scripts/deploy.js.
NEXT_PUBLIC_CONTRACT_ADDRESS=

# Pin the dapp to a specific chain. The UI will warn and refuse to send txs if the
# wallet is on a different chain. Recommended in production.
# Hardhat = 31337, Sepolia = 11155111, Mainnet = 1.
NEXT_PUBLIC_CHAIN_ID=
